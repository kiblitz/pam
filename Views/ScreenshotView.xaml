<UserControl x:Class="Pam.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title with back button -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Click="Back_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x2190;" FontSize="14" Foreground="#88FFFFFF"
                                   x:Name="Arrow"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Foreground" Value="#CCFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Screenshot"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#EEFFFFFF"/>
        </DockPanel>

        <!-- Delay input -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Foreground="#AAFFFFFF" FontSize="11"
                       VerticalAlignment="Center" Text="Delay: "/>
            <TextBox x:Name="DelayInput" Text="0"
                     Width="30" FontSize="11"
                     Foreground="#DDFFFFFF" Background="#22FFFFFF"
                     BorderBrush="#44FFFFFF" BorderThickness="1"
                     CaretBrush="White" Padding="4,2"
                     HorizontalContentAlignment="Right"
                     TextChanged="DelayInput_TextChanged"
                     GotFocus="DelayInput_GotFocus"
                     PreviewMouseLeftButtonDown="DelayInput_PreviewMouseDown"/>
            <TextBlock Foreground="#AAFFFFFF" FontSize="11"
                       VerticalAlignment="Center" Margin="2,0,0,0" Text="s"/>
        </StackPanel>

        <!-- Capture button -->
        <Button Grid.Row="4" Click="Capture_Click" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="8,6"
                            x:Name="Bg" HorizontalAlignment="Stretch">
                        <TextBlock Text="Capture" Foreground="#DDFFFFFF"
                                   FontSize="12" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Record row: button + fps input -->
        <DockPanel Grid.Row="6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <TextBox x:Name="FpsInput" Text="90"
                         Width="30" FontSize="11"
                         Foreground="#DDFFFFFF" Background="#22FFFFFF"
                         BorderBrush="#44FFFFFF" BorderThickness="1"
                         CaretBrush="White" Padding="4,2"
                         HorizontalContentAlignment="Right"
                         TextChanged="FpsInput_TextChanged"
                         GotFocus="FpsInput_GotFocus"
                         PreviewMouseLeftButtonDown="FpsInput_PreviewMouseDown"/>
                <TextBlock Foreground="#AAFFFFFF" FontSize="11"
                           VerticalAlignment="Center" Margin="2,0,0,0" Text="fps"/>
            </StackPanel>
            <Button Click="Record_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{Binding IsRecording, Converter={StaticResource RecordingBrushConverter}}"
                                CornerRadius="8" Padding="8,6"
                                x:Name="Bg" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="Label"
                                       Text="{Binding IsRecording, Converter={StaticResource RecordingTextConverter}}"
                                       Foreground="#DDFFFFFF"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <!-- Status -->
        <TextBlock Grid.Row="8"
                   Text="{Binding StatusText, Mode=OneWay}"
                   Foreground="#66FFFFFF" FontSize="10"
                   HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
