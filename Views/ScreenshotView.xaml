<UserControl x:Class="Pam.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title with back button -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Click="Back_Click" Cursor="Hand"
                    Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x2190;" FontSize="14" Foreground="#88FFFFFF"
                                   x:Name="Arrow"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Foreground" Value="#CCFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Screenshot"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#EEFFFFFF"/>
        </DockPanel>

        <!-- Delay selector -->
        <DockPanel Grid.Row="2">
            <TextBlock Foreground="#AAFFFFFF" FontSize="11"
                       VerticalAlignment="Center" Text="Delay: "/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Delay0" Content="0s" IsChecked="True"
                             Foreground="#AAFFFFFF" Margin="0,0,8,0"
                             Checked="Delay_Changed" Tag="0"/>
                <RadioButton x:Name="Delay3" Content="3s"
                             Foreground="#AAFFFFFF" Margin="0,0,8,0"
                             Checked="Delay_Changed" Tag="3"/>
                <RadioButton x:Name="Delay5" Content="5s"
                             Foreground="#AAFFFFFF" Margin="0,0,8,0"
                             Checked="Delay_Changed" Tag="5"/>
                <RadioButton x:Name="Delay10" Content="10s"
                             Foreground="#AAFFFFFF"
                             Checked="Delay_Changed" Tag="10"/>
            </StackPanel>
        </DockPanel>

        <!-- Action buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="Capture_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="8,6"
                                x:Name="Bg" HorizontalAlignment="Stretch">
                            <TextBlock Text="Capture" Foreground="#DDFFFFFF"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="2" Click="Record_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{Binding IsRecording, Converter={StaticResource RecordingBrushConverter}}"
                                CornerRadius="8" Padding="8,6"
                                x:Name="Bg" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="Label"
                                       Text="{Binding IsRecording, Converter={StaticResource RecordingTextConverter}}"
                                       Foreground="#DDFFFFFF"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="6"
                   Text="{Binding StatusText, Mode=OneWay}"
                   Foreground="#66FFFFFF" FontSize="10"
                   HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
