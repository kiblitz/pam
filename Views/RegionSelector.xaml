<Window x:Class="Pam.Views.RegionSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Cursor="Cross">

    <Canvas x:Name="OverlayCanvas">
        <!-- Dim overlay with cutout -->
        <Border x:Name="DimOverlay" Background="#44000000"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>

        <!-- Selection rectangle -->
        <Border x:Name="SelectionRect"
                BorderBrush="#CCFFFFFF"
                BorderThickness="2"
                Background="Transparent"
                Visibility="Collapsed"/>

        <!-- Instructions -->
        <TextBlock x:Name="InstructionText"
                   Text="Click and drag to select region. Press Escape to cancel."
                   Foreground="White" FontSize="14"
                   Canvas.Left="20" Canvas.Top="20">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Countdown overlay -->
        <TextBlock x:Name="CountdownText"
                   Foreground="White" FontSize="72" FontWeight="Bold"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="6"/>
            </TextBlock.Effect>
        </TextBlock>
    </Canvas>
</Window>
