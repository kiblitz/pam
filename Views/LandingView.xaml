<UserControl x:Class="Pam.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pam"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#EEFFFFFF"/>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Apps, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#22FFFFFF" CornerRadius="8" Padding="10,8"
                            Margin="0,0,0,6" Cursor="Hand"
                            MouseLeftButtonUp="AppItem_Click">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text=">"
                                       Foreground="#66FFFFFF" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#DDFFFFFF" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#77FFFFFF" FontSize="10"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
