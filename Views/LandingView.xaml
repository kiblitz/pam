<UserControl x:Class="Pam.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ItemsControl ItemsSource="{Binding Apps, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="AppItem_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            Padding="0" Margin="0,0,0,6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#22FFFFFF" CornerRadius="8" Padding="10,8"
                                        x:Name="Bg">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text=">"
                                       Foreground="#66FFFFFF" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#DDFFFFFF" FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#77FFFFFF" FontSize="10"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
