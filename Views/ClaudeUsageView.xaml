<UserControl x:Class="Pam.Views.ClaudeUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Click="Back_Click" Cursor="Hand"
                    VerticalAlignment="Center" Padding="0" Margin="0"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#x2190;" FontSize="14" Foreground="#88FFFFFF"
                                   x:Name="Arrow"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Foreground" Value="#CCFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="Claude Usage"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#EEFFFFFF"/>
        </DockPanel>

        <!-- 5-Hour Window -->
        <StackPanel Grid.Row="2">
            <DockPanel Margin="0,0,0,3">
                <TextBlock DockPanel.Dock="Right" Foreground="#88FFFFFF" FontSize="10"
                           Text="{Binding FiveHourRemainingText, StringFormat='resets {0}', Mode=OneWay}"/>
                <TextBlock Foreground="#AAFFFFFF" FontSize="11">
                    <Run Text="5-hour: "/>
                    <Run Text="{Binding FiveHourUtil, StringFormat='{}{0:F1}%', Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
            <Grid Height="6">
                <Border Background="#33FFFFFF" CornerRadius="3"/>
                <Border CornerRadius="3" HorizontalAlignment="Left" Background="#446EC6FF">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                            <Binding Path="FiveHourLocalUtil" Mode="OneWay"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                        </MultiBinding>
                    </Border.Width>
                </Border>
                <Border CornerRadius="3" HorizontalAlignment="Left" Background="#FF6EC6FF">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                            <Binding Path="FiveHourUtil" Mode="OneWay"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                        </MultiBinding>
                    </Border.Width>
                </Border>
            </Grid>
        </StackPanel>

        <!-- 7-Day Window -->
        <StackPanel Grid.Row="4">
            <DockPanel Margin="0,0,0,3">
                <TextBlock DockPanel.Dock="Right" Foreground="#88FFFFFF" FontSize="10"
                           Text="{Binding SevenDayRemainingText, StringFormat='resets {0}', Mode=OneWay}"/>
                <TextBlock Foreground="#AAFFFFFF" FontSize="11">
                    <Run Text="7-day: "/>
                    <Run Text="{Binding SevenDayUtil, StringFormat='{}{0:F1}%', Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
            <Grid Height="6">
                <Border Background="#33FFFFFF" CornerRadius="3"/>
                <Border CornerRadius="3" HorizontalAlignment="Left" Background="#448BE8A0">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                            <Binding Path="SevenDayLocalUtil" Mode="OneWay"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                        </MultiBinding>
                    </Border.Width>
                </Border>
                <Border CornerRadius="3" HorizontalAlignment="Left" Background="#FF8BE8A0">
                    <Border.Width>
                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                            <Binding Path="SevenDayUtil" Mode="OneWay"/>
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                        </MultiBinding>
                    </Border.Width>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="6"
                   Text="{Binding StatusText, FallbackValue=Waiting..., Mode=OneWay}"
                   Foreground="#66FFFFFF" FontSize="10"
                   HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
